    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The GitHub requests of the roadmap Service in the last hour, as a share of its hourly budget service.github_requests_per_hour. The dashed line is the limit, 100 %. Only the Service keeps this budget: the cluster Jobs and the workstations do not count in it. Metrics: devops_cli_service_budget_spent_requests and devops_cli_service_budget_limit_requests. The panel shows the Service budget until #4752 records the rate limit of each GitHub answer.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Budget used (%)",
