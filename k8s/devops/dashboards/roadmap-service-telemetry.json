          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "title": "Errors: share of failed rounds and rejected webhooks",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(devops_cli_service_jobs_total{job=~\"$job\",repo=~\"$repo\",result=\"error\"}[$__rate_interval])) or sum(rate(devops_cli_service_jobs_total{job=~\"$job\",repo=~\"$repo\"}[$__rate_interval])) * 0) / sum(rate(devops_cli_service_jobs_total{job=~\"$job\",repo=~\"$repo\"}[$__rate_interval]))",
          "legendFormat": "failed rounds",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(devops_cli_service_webhook_deliveries_total{job=~\"$job\",repo=~\"$repo\",outcome=\"rejected\"}[$__rate_interval])) or sum(rate(devops_cli_service_webhook_deliveries_total{job=~\"$job\",repo=~\"$repo\"}[$__rate_interval])) * 0) / sum(rate(devops_cli_service_webhook_deliveries_total{job=~\"$job\",repo=~\"$repo\"}[$__rate_interval]))",
          "legendFormat": "rejected webhooks",
          "refId": "B"
        }
      ]
    },
