      "title": "Release Intervals",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_avg(sum by (release) (last_over_time(devops_cli_project_release_interval_days[$__range])))",
          "legendFormat": "{{release}}",
          "refId": "A"
        }
      ]
    },
