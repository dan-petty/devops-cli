    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Overall pass rate percentage across all CI workflows. It shows the latest value of each series in the time range, and no data when none was sent in it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 19 },
