        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        }
      },
      "title": "CI Quality Gate Pass Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(devops_cli_project_ci_runs_total{conclusion=\"success\"}[$__range])) / clamp_min(sum(increase(devops_cli_project_ci_runs_total[$__range])), 1) * 100",
          "instant": true,
          "legendFormat": "Pass Rate %",
          "refId": "A"
        }
      ]
    },
