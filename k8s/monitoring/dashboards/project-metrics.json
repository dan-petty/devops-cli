      "title": "CI Quality Gate Pass Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(last_over_time(devops_cli_project_ci_runs{conclusion=\"success\"}[$__range])) / clamp_min(sum(last_over_time(devops_cli_project_ci_runs[$__range])), 1) * 100",
          "instant": true,
          "legendFormat": "Pass Rate %",
          "refId": "A"
        }
      ]
    },
