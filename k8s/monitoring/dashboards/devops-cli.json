          "expr": "histogram_quantile(0.95, sum by (stage) (increase(devops_cli_rag_query_duration_ms{stage=~\"embedding|search|ranking\"}[1h])))",
          "legendFormat": "p95 {{stage}}",
          "refId": "A"
        },
        {
          "datasource": {
