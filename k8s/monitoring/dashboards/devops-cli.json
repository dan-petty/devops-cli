      "title": "CLI Invocations by Command",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(devops_cli_command_total[1h])) by (command) or vector(0)",
          "legendFormat": "devops {{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
