          "placement": "bottom"
        }
      },
      "title": "Qdrant Retries by Operation and Error",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operation, error_type) (increase(devops_cli_qdrant_retries_total[1h]))",
          "legendFormat": "{{operation}} {{error_type}}",
          "refId": "A"
        }
      ]
    },
