      "title": "Spans Accepted and Refused per Receiver",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_spans[5m]))",
          "legendFormat": "{{receiver}} accepted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (receiver) (rate(otelcol_receiver_refused_spans[5m]))",
          "legendFormat": "{{receiver}} refused",
          "refId": "B"
        }
      ],
      "description": "Spans per second each receiver passed into the pipeline, and those it refused, which the memory_limiter does once heap use passes its soft limit."
