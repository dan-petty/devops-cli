        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pod) (otelcol_process_runtime_heap_alloc_bytes)",
          "legendFormat": "{{pod}} heap in use",
          "refId": "B"
        }
      ],
      "description": "The memory_limiter refuses data once heap use passes 300 MiB (its 400 MiB limit less the 100 MiB spike allowance) and forces garbage collection at 400 MiB."
