      "title": "Calls in Flight per Deployment",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (api_base) (rate(litellm_llm_api_latency_metric_sum[$__rate_interval]) * on (model_id) group_left (api_base) group by (model_id, api_base) (litellm_deployment_total_requests_total{api_base!=\"\"}))",
          "legendFormat": "{{api_base}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(sum by (api_base) (rate(litellm_llm_api_latency_metric_sum[$__rate_interval]) * on (model_id) group_left (api_base) group by (model_id, api_base) (litellm_deployment_total_requests_total{api_base!=\"\"})))",
          "legendFormat": "Total (Sum)",
          "refId": "B"
        }
      ],
      "description": "Mean concurrent calls the gateway had on each deployment (call seconds per second). Covers the Ollama nodes, which export no metrics."
    },
