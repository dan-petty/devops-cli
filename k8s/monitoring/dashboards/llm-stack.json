          "refId": "A",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (requested_model, fallback_model) (increase(litellm_deployment_failed_fallbacks_total[$__range]))",
          "legendFormat": "{{requested_model}} -> {{fallback_model}} failed",
          "refId": "B",
          "instant": true
        }
      ],
      "description": "Requests in the time range that failed on their model and were retried on its fallback, and whether the fallback answered. increase() needs two samples of a series, so the first fallback of a new series adds nothing."
