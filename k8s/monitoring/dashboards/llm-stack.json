      },
      "title": "Cooldowns per Deployment in Range",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (api_base, exception_status) (increase(litellm_deployment_cooled_down_total[$__range]))",
          "legendFormat": "{{api_base}} ({{exception_status}})",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Times in the time range the router took a deployment out of rotation after repeated failures (allowed_fails 3, cooldown_time 30 s), by the status that caused it. increase() needs two samples of a series, so the first cooldown of a new series adds nothing."
    },
