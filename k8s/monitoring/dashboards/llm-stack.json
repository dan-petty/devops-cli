      "title": "Time to First Token p95 per Model",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(litellm_llm_api_time_to_first_token_metric_bucket[$__rate_interval])))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "description": "Seconds from a streamed request reaching a deployment to its first token, as the gateway measured it. Only streamed requests record it."
    },
    {
      "datasource": {
