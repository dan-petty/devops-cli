        {
          "expr": "1 - (sum(increase(traefik_service_requests_total{service=~\"devops-roadmap-service-[0-9]+@kubernetes\", code=~\"5..\"}[30d])) or sum(increase(traefik_service_requests_total{service=~\"devops-roadmap-service-[0-9]+@kubernetes\"}[30d])) * 0) / sum(increase(traefik_service_requests_total{service=~\"devops-roadmap-service-[0-9]+@kubernetes\"}[30d]))",
          "instant": true,
          "range": false,
          "refId": "A"
