      "targets": [
        {
          "expr": "(sum(increase(traefik_service_requests_total{service=~\"devops-roadmap-service-[0-9]+@kubernetes\", code=~\"5..\"}[1h])) or sum(increase(traefik_service_requests_total{service=~\"devops-roadmap-service-[0-9]+@kubernetes\"}[1h])) * 0) / sum(increase(traefik_service_requests_total{service=~\"devops-roadmap-service-[0-9]+@kubernetes\"}[1h])) / 0.001",
          "instant": true,
          "range": false,
          "refId": "A"
