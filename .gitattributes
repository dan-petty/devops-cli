# Enforce LF line endings for all text files across all platforms
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.tar.gz binary
*.whl binary

# Generated files: a tool writes them, and nobody edits them by hand. GitHub folds their diffs,
# and `devops roadmap review run` counts their lines apart from the other lines.
uv.lock linguist-generated
**/package-lock.json linguist-generated
CHANGELOG.md linguist-generated
.release-please-manifest.json linguist-generated
docs/CLI_REFERENCE.md linguist-generated=true
docs/CONFIGURATION.md linguist-generated=true
docs/ENV_VARS.md linguist-generated=true
docs/ERRORS.md linguist-generated=true
docs/KNOWLEDGE_BASE.md linguist-generated=true
docs/MCP_TOOLS.md linguist-generated=true
docs/TELEMETRY.md linguist-generated=true
docs/commands/*.md linguist-generated=true
CLAUDE.md linguist-generated=true
GEMINI.md linguist-generated=true
.github/copilot-instructions.md linguist-generated=true

# Vendored files: the data of a third party, which nobody edits. GitHub leaves them out of the
# language counts, and `devops ai rag index` leaves them out of the index. The tiktoken
# vocabularies are the data of tiktoken.
tests/fixtures/tiktoken/*.tiktoken linguist-vendored
