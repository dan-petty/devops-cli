{
  "log": {
    "warnings": "error",
    "verbosity": "verbose"
  },
  "source": [
    "design/tokens/dark.tokens.json"
  ],
  "platforms": {
    "docs": {
      "transformGroup": "css",
      "buildPath": "docs/assets/css/",
      "files": [
        {
          "destination": "tokens-dark-explicit.css",
          "format": "css/variables",
          "options": {
            "selector": ":root[data-theme=\"dark\"]",
            "outputReferences": true
          }
        }
      ]
    },
    "package": {
      "transformGroup": "css",
      "buildPath": "src/devops_cli/design/",
      "files": [
        {
          "destination": "tokens-dark-explicit.css",
          "format": "css/variables",
          "options": {
            "selector": ":root[data-theme=\"dark\"]",
            "outputReferences": true
          }
        }
      ]
    }
  }
}
