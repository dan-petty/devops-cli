{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["type/chore", "scope/ci"],
  "commitMessagePrefix": "chore(deps):",
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/^k8s/argocd/apps/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["pep621", "pip_requirements", "pip-compile", "setup-cfg"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "labels": ["type/chore", "scope/infra"]
    },
    {
      "matchManagers": ["kubernetes"],
      "labels": ["type/chore", "scope/infra"]
    },
    {
      "matchManagers": ["argocd"],
      "labels": ["type/chore", "scope/infra"]
    },
    {
      "description": "Renovate reads an Application source with no chart as a git dependency. Argo CD tracks main on purpose (ADR 0013), so those dependencies stay off.",
      "matchManagers": ["argocd"],
      "matchDatasources": ["git-tags"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "labels": ["type/chore", "scope/ci"]
    },
    {
      "description": "A base image update of the service image is a fix, so release-please releases it. Other updates stay chore and release nothing alone.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile"],
      "commitMessagePrefix": "fix(deps):"
    }
  ]
}
