{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["type/chore", "scope/ci"],
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "matchManagers": ["pep621", "pip_requirements", "pip-compile", "setup-cfg"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "labels": ["type/chore", "scope/infra"]
    },
    {
      "matchManagers": ["github-actions"],
      "labels": ["type/chore", "scope/ci"]
    },
    {
      "description": "A base image update of the service image is a fix, so release-please releases it. Other updates stay chore and release nothing alone.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile"],
      "commitMessagePrefix": "fix(deps):",
      "prBodyNotes": ["Fail-to-pass: not applicable: a base image update changes no test."]
    }
  ]
}
