# uv
.uv/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# pytest
.pytest_cache/
.coverage*
coverage.xml
htmlcov/

# VS Code (track team configurations, ignore user-specific overrides)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Generated repo clones
repos/
.code-workspace

# OS
.DS_Store
Thumbs.db

# Secrets / config (never commit)
*.env
.env.*
secrets/

# Local project config override (copy config.example.yaml → config.yaml to activate)
/config.yaml

# devops-cli's in-cluster config: `devops k8s deploy-stack` renders it from config.yaml at deploy
# time (k8s/devops/configmap.example.yaml is the template), so a copy never belongs in git
/k8s/devops/configmap.yaml

# Local data directory — reports, review output, computed artefacts
.data/*
!.data/.gitkeep

# Claude: the shared project settings are committed; local settings, scratch and worktrees are not
.claude/*
!.claude/settings.json

# Kilo Code
.kilo/

# Import analysis cache
.grimp_cache/
.import_linter_cache/
