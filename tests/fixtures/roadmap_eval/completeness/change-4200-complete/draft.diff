+    before = _tokens_count("fix")
+    _end(kube, "Complete")
+
+    _round(store, staged_repo)
+
+    assert (
+        _tokens_count("fix") - before,
+        _record(store, number).get("implement.spend_counted"),
+    ) == (
+        900,
+        "900",
+    )
