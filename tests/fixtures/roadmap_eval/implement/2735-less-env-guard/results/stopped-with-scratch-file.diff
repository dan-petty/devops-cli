+def test_build_subprocess_env_less_security() -> None:
+    """Verify that LESS environment variable is refused for security reasons."""
+    # Test that LESS is refused with a SecurityError
+    with pytest.raises(SecurityError, match="Prohibited dangerous environment variable override: 'LESS'"):
+        build_subprocess_env(env={"LESS": "+!x\\n"})
+    
+    # Test that LESS with isolation disabled is also refused  
+    with pytest.raises(SecurityError, match="Prohibited dangerous environment variable override: 'LESS'"):
+        build_subprocess_env(env={"LESS": "+!x\\n"}, isolate_env=False)
+
+    # Verify that LESSOPEN still raises SecurityError (regression test)
+    with pytest.raises(SecurityError, match="Prohibited dangerous environment variable override: 'LESSOPEN'"):
+        build_subprocess_env(env={"LESSOPEN": "|x %s"})
