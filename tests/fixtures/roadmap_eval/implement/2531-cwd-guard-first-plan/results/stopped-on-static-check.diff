@@ -0,0 +1,62 @@
+"""Unit tests for OpenTelemetry tracer and metrics emitter."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from unittest.mock import patch
+
+from devops_cli.telemetry.tracer import (
+    _detect_vcs_metadata,
+    _resolve_git_dir,
+)
+
+
+def test_resolve_git_dir_with_deleted_cwd():
+    """Test that _resolve_git_dir returns None when CWD is deleted (FileNotFoundError)."""
+    # Mock Path.cwd() to raise FileNotFoundError
+    with patch("pathlib.Path.cwd") as mock_cwd:
+        mock_cwd.side_effect = FileNotFoundError("No such file or directory")
+
+        # This should not raise an exception, but return None
+        result = _resolve_git_dir()
+        assert result is None
+
+
+def test_resolve_git_dir_with_valid_start_dir():
+    """Test that _resolve_git_dir works correctly with a valid start_dir."""
+    # Create a temporary directory structure for testing
+    import shutil
+    import tempfile
+
+    temp_dir = Path(tempfile.mkdtemp())
+    try:
+        git_dir = temp_dir / ".git"
+        git_dir.mkdir()
+
+        result = _resolve_git_dir(start_dir=temp_dir)
+        assert result == git_dir
+    finally:
+        shutil.rmtree(temp_dir, ignore_errors=True)
+
+
+def test_detect_vcs_metadata_with_deleted_cwd():
+    """Test that _detect_vcs_metadata handles deleted CWD gracefully."""
+    # Mock Path.cwd() to raise FileNotFoundError
+    with patch("pathlib.Path.cwd") as mock_cwd:
+        mock_cwd.side_effect = FileNotFoundError("No such file or directory")
+
+        # This should not raise an exception, but return empty dict
+        result = _detect_vcs_metadata()
+        assert isinstance(result, dict)
+        assert len(result) == 0
+
+
+def test_detect_vcs_metadata_with_valid_git():
+    """Test that _detect_vcs_metadata works correctly with a valid git directory."""
+    # This test depends on having a real git repository or mock setup
+    # For now, we'll just ensure it doesn't crash when _resolve_git_dir returns None
+    with patch("devops_cli.telemetry.tracer._resolve_git_dir") as mock_resolve:
+        mock_resolve.return_value = None  # No git directory found
+
+        result = _detect_vcs_metadata()
+        assert isinstance(result, dict)
