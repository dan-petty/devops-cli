+from devops_cli.ai.client.unified import LLMClient
+
+
+class TestGetOllamaSemaphoreDeletion(unittest.TestCase):
+    def test_llm_client_has_no_get_ollama_semaphore(self):
+        """Test that LLMClient no longer has _get_ollama_semaphore attribute."""
+        # This test should fail before deletion and pass after
+        self.assertFalse(hasattr(LLMClient, "_get_ollama_semaphore"))
+
