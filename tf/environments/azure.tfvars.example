resource_group_name  = "rg-devops-cli-k8s"
location             = "eastus"
cluster_name         = "devops-cli-aks"
dns_prefix           = "devops-cli-k8s"
kubernetes_version   = "1.30"
node_vm_size         = "Standard_D4s_v5"
node_count           = 3
min_node_count       = 2
max_node_count       = 5
vnet_address_space   = ["10.200.0.0/16"]
subnet_address_prefix = "10.200.1.0/24"
tags = {
  Environment = "production"
  ManagedBy   = "devops-cli-opentofu"
  Project     = "devops-cli"
}
