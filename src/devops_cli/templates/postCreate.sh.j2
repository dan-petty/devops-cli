#!/usr/bin/env bash
set -euo pipefail

# ── uv ────────────────────────────────────────────────────────────────────────
if ! command -v uv &>/dev/null; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# ── Python {{ python_version }} ───────────────────────────────────────────────
uv python install {{ python_version }}

# ── Project dependencies ──────────────────────────────────────────────────────
if [ -f pyproject.toml ]; then
  uv sync
fi

# ── Bash history persistence (named volume at /commandhistory) ────────────────
mkdir -p /commandhistory
touch /commandhistory/.bash_history
chmod 600 /commandhistory/.bash_history

if ! grep -q 'HISTFILE=/commandhistory' "${HOME}/.bashrc" 2>/dev/null; then
  cat >> "${HOME}/.bashrc" <<'BASHRC'

# ── Persistent bash history ──────────────────────────────────────────────────
export HISTFILE=/commandhistory/.bash_history
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
export PATH="$HOME/.local/bin:$PATH"
BASHRC
fi

# ── SSH key permissions ───────────────────────────────────────────────────────
if [ -d "${HOME}/.ssh" ]; then
  chmod 700 "${HOME}/.ssh"
  find "${HOME}/.ssh" -maxdepth 1 -name "id_*" ! -name "*.pub" -exec chmod 600 {} +
  find "${HOME}/.ssh" -maxdepth 1 -name "*.pub" -exec chmod 644 {} +
fi

# ── Git SSH commit signing ────────────────────────────────────────────────────
# Match only expected id_ed25519-YYYYMMMDD key names (e.g. id_ed25519-2024JAN15)
NEWEST_KEY=$(find "${HOME}/.ssh" -maxdepth 1 -name 'id_ed25519-????????' \
  | grep -E '/id_ed25519-[0-9]{4}[A-Z]{3}[0-9]{2}$' | sort | tail -1 || true)
if [ -n "${NEWEST_KEY:-}" ]; then
  git config --global gpg.format ssh
  git config --global user.signingkey "${NEWEST_KEY}"
  git config --global commit.gpgsign true
  git config --global tag.gpgsign true
  echo "✓ git signing configured: ${NEWEST_KEY##*/}"
fi

# ── MCP configuration ─────────────────────────────────────────────────────────
mkdir -p "${HOME}/.gemini/config"
if [ -f ".vscode/mcp.json" ]; then
  sed "s|\${workspaceFolder}|$(pwd)|g" .vscode/mcp.json > "${HOME}/.gemini/config/mcp_config.json"
  echo "✓ mcp configuration synced to ~/.gemini/config/mcp_config.json"
fi

echo "✓ postCreate complete"

