{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": true,
    "grafana-mcp@claude-plugins-official": true
  },
  "env": {
    "DO_NOT_TRACK": "1",
    "OPENSPEC_TELEMETRY": "0",
    "OPENSPEC_NO_UPDATE_CHECK": "1",
    "UV_MALWARE_CHECK": "1",
    "UV_COMPILE_BYTECODE": "0",
    "VIRTUAL_ENV": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f \"$CLAUDE_PROJECT_DIR/.pre-commit-config.yaml\" ] && command -v uv >/dev/null || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && uv run pre-commit install >&2"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run devops *)",
      "Bash(uv run pytest *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(openspec *)",
      "Bash(tuicr *)",
      "Bash(make *)",
      "Bash(kubectl *)",
      "Bash(ansible *)",
      "Bash(ansible-playbook *)",
      "Bash(ansible-inventory *)",
      "Bash(ansible-lint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Bash(git push * --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(gh *)"
    ]
  }
}
